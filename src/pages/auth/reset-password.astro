---
import AuthLayout from "../../layouts/AuthLayout.astro";
import ResetPasswordForm from "../../components/auth/ResetPasswordForm";
import { getCurrentUserFromCookies } from "../../lib/auth";

const currentUser = await getCurrentUserFromCookies(Astro.cookies);

if (currentUser) {
    return Astro.redirect("/settings");
}

const token = Astro.url.searchParams.get("token") ?? "";
const hasToken = token.length > 0;
---

<AuthLayout
    title="Restablecer contraseña"
    description="Crea una contraseña nueva y segura para tu cuenta."
>
    {
        hasToken ? (
            <ResetPasswordForm token={token} client:load />
        ) : (
            <div class="card-glass p-6 text-center text-slate-200">
                El enlace no es válido. Solicita uno nuevo.
            </div>
        )
    }
</AuthLayout>
