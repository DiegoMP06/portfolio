---
// src/components/Skills.astro
import { aiSkills, webSkills, extraSkills } from "../../data/portfolio";
---

<section id="skills" class="py-24 relative overflow-hidden">
    <div
        class="bg-blob w-[22rem] h-[22rem] bottom-0 left-0"
        style="background:rgba(139,92,246,.05);"
    >
    </div>

    <div class="max-w-[1152px] mx-auto px-6">
        <!-- Header -->
        <div class="text-center mb-16 reveal">
            <p
                class="font-mono text-[0.7rem] tracking-[0.25em] uppercase text-neon mb-3"
            >
                // habilidades
            </p>
            <h2
                class="font-display font-bold text-[clamp(1.5rem,3vw,2.25rem)] tracking-[0.05em] mb-3"
            >
                Stack <span class="gradient-text">Tecnológico</span>
            </h2>
            <div class="section-line mx-auto mb-4"></div>
            <p class="text-dim max-w-[32rem] mx-auto text-[0.9rem]">
                Una combinación de IA en crecimiento constante y desarrollo web
                full stack maduro.
            </p>
        </div>

        <!-- Cards row -->
        <div class="grid grid-cols-2 gap-6 max-md:grid-cols-1">
            <!-- AI card -->
            <div class="card-glass p-8 reveal rd1">
                <div class="flex items-center gap-3.5 mb-7">
                    <div
                        class="w-10 h-10 rounded-lg flex items-center justify-center shrink-0"
                        style="background:rgba(255,45,85,.1);border:1px solid rgba(255,45,85,.25);"
                    >
                        <svg
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="#ff2d55"
                            stroke-width="2"
                        >
                            <path
                                d="M12 2a10 10 0 1 1 0 20A10 10 0 0 1 12 2m0 4-1.5 3H7l2.5 2-1 3L12 13l3.5 1L14 11l2.5-2h-3.5L12 6z"
                            ></path>
                        </svg>
                    </div>
                    <div>
                        <h3 class="font-heading font-semibold text-fore">
                            Inteligencia Artificial
                        </h3>
                        <span
                            class="font-mono text-[0.65rem] tracking-[0.12em] uppercase text-red"
                            >En crecimiento 🚀</span
                        >
                    </div>
                </div>

                <div class="flex flex-col gap-4">
                    {
                        aiSkills.map(({ name, pct }) => (
                            <div class="flex flex-col gap-1.5">
                                <div class="flex justify-between">
                                    <span class="font-heading text-[0.8rem] text-dim">
                                        {name}
                                    </span>
                                    <span class="font-mono text-[0.7rem] text-red">
                                        {pct}%
                                    </span>
                                </div>
                                <div class="h-1 rounded-full bg-stroke overflow-hidden">
                                    <div
                                        class="skill-bar h-full rounded-full w-0 transition-all duration-[1s] ease-[cubic-bezier(0,0,.2,1)]"
                                        data-width={pct}
                                        style="background:linear-gradient(to right,#ff2d55,#ff006e);"
                                    />
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>

            <!-- Web card -->
            <div class="card-glass p-8 reveal rd2">
                <div class="flex items-center gap-3.5 mb-7">
                    <div
                        class="w-10 h-10 rounded-lg flex items-center justify-center shrink-0"
                        style="background:rgba(0,212,255,.1);border:1px solid rgba(0,212,255,.25);"
                    >
                        <svg
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="#00d4ff"
                            stroke-width="2"
                        >
                            <polyline points="16 18 22 12 16 6"></polyline>
                            <polyline points="8 6 2 12 8 18"></polyline>
                        </svg>
                    </div>
                    <div>
                        <h3 class="font-heading font-semibold text-fore">
                            Desarrollo Web
                        </h3>
                        <span
                            class="font-mono text-[0.65rem] tracking-[0.12em] uppercase text-neon"
                            >Full Stack</span
                        >
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-2.5">
                    {
                        webSkills.map(({ name, pct }) => (
                            <div
                                class="p-3 rounded-lg border border-stroke bg-card/50 transition-all duration-200
                        hover:border-neon/30 hover:bg-neon/[0.04]"
                            >
                                <div class="font-heading text-[0.8rem] text-dim mb-1.5 transition-colors duration-200">
                                    {name}
                                </div>
                                <div class="h-[3px] rounded-full bg-stroke overflow-hidden">
                                    <div
                                        class="web-bar h-full rounded-full w-0 transition-all duration-[1.1s] ease-[cubic-bezier(0,0,.2,1)]"
                                        data-width={pct}
                                        style="background:linear-gradient(to right,#00d4ff,#06b6d4);"
                                    />
                                </div>
                                <span class="font-mono text-[0.65rem] text-neon/60 mt-1 block">
                                    {pct}%
                                </span>
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>

        <!-- Extras row -->
        <div class="reveal mt-6">
            <div class="card-glass p-8">
                <div class="flex items-center gap-3.5 mb-6">
                    <div
                        class="w-10 h-10 rounded-lg flex items-center justify-center shrink-0"
                        style="background:rgba(139,92,246,.1);border:1px solid rgba(139,92,246,.25);"
                    >
                        <svg
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="#8b5cf6"
                            stroke-width="2"
                        >
                            <circle cx="12" cy="12" r="3"></circle>
                            <path
                                d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"
                            ></path>
                        </svg>
                    </div>
                    <h3 class="font-heading font-semibold text-fore">
                        Extras & Herramientas
                    </h3>
                </div>
                <div class="grid grid-cols-4 gap-4 max-sm:grid-cols-2">
                    {
                        extraSkills.map(({ emoji, name, level }) => (
                            <div
                                class="p-5 text-center rounded-xl border border-stroke bg-card
                        transition-all duration-200 hover:border-purple/35 hover:-translate-y-0.5"
                            >
                                <div class="text-2xl mb-2">{emoji}</div>
                                <div class="font-heading text-[0.8rem] text-fore mb-1 transition-colors duration-200">
                                    {name}
                                </div>
                                <div class="font-mono text-[0.6rem] text-dim">
                                    {level}
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    // Animate skill bars when they enter viewport
    const allBars = document.querySelectorAll<HTMLElement>(
        ".skill-bar, .web-bar",
    );
    const barIO = new IntersectionObserver(
        (entries) => {
            entries.forEach((e) => {
                if (e.isIntersecting) {
                    const el = e.target as HTMLElement;
                    const w = el.dataset.width;
                    if (w)
                        setTimeout(() => {
                            el.style.width = w + "%";
                        }, 200);
                    barIO.unobserve(el);
                }
            });
        },
        { threshold: 0.3 },
    );
    allBars.forEach((b) => barIO.observe(b));
</script>
