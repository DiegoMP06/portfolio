---
// src/components/Services.astro
import { services } from "../../data/portfolio";

const iconWrapStyle: Record<string, string> = {
    red: "background:rgba(255,45,85,.1);border:1px solid rgba(255,45,85,.25);",
    blue: "background:rgba(0,212,255,.1);border:1px solid rgba(0,212,255,.25);",
    purple: "background:rgba(139,92,246,.1);border:1px solid rgba(139,92,246,.25);",
    cyan: "background:rgba(6,182,212,.1);border:1px solid rgba(6,182,212,.25);",
    pink: "background:rgba(255,0,110,.1);border:1px solid rgba(255,0,110,.25);",
    yel: "background:rgba(245,158,11,.1);border:1px solid rgba(245,158,11,.25);",
};

const tagStyle: Record<string, string> = {
    red: "border:1px solid rgba(255,45,85,.2);background:rgba(255,45,85,.06);color:rgba(255,45,85,.75);",
    purple: "border:1px solid rgba(139,92,246,.25);background:rgba(139,92,246,.08);color:rgba(139,92,246,.9);",
    blue: "border:1px solid rgba(0,212,255,.25);background:rgba(0,212,255,.07);color:rgba(0,212,255,.8);",
    cyan: "border:1px solid rgba(6,182,212,.25);background:rgba(6,182,212,.07);color:rgba(6,182,212,.8);",
    pink: "border:1px solid rgba(255,0,110,.25);background:rgba(255,0,110,.07);color:rgba(255,0,110,.8);",
};
---

<section id="services" class="py-24 relative overflow-hidden">
    <div
        class="bg-blob w-[28rem] h-[28rem] top-[10%] -left-[5%]"
        style="background:rgba(255,45,85,.04);"
    >
    </div>
    <div
        class="bg-blob w-[22rem] h-[22rem] bottom-[5%] -right-[3%]"
        style="background:rgba(139,92,246,.05);"
    >
    </div>

    <div class="max-w-[1152px] mx-auto px-6">
        <!-- Header -->
        <div class="text-center mb-14 reveal">
            <p
                class="font-mono text-[0.7rem] tracking-[0.25em] uppercase text-red mb-3"
            >
                // servicios
            </p>
            <h2
                class="font-display font-bold text-[clamp(1.5rem,3vw,2.25rem)] tracking-[0.05em] mb-3"
            >
                ¿En qué te puedo <span class="gradient-text-yel">ayudar</span>?
            </h2>
            <div class="section-line-yel mx-auto mb-4"></div>
            <p class="text-dim max-w-[30rem] mx-auto text-[0.9rem]">
                Si tienes un proyecto, una idea o un problema técnico — aquí es
                donde entro yo. Freelance o colaboración de equipo.
            </p>
        </div>

        <div
            class="grid grid-cols-3 gap-6 max-[900px]:grid-cols-2 max-[600px]:grid-cols-1"
        >
            {
                services.map(
                    (
                        { num, icon, iconColor, title, desc, tags, tagColor },
                        i,
                    ) => (
                        <div
                            class={`svc-hover-glow relative flex flex-col p-8 rounded-2xl border border-stroke bg-card overflow-hidden
                  transition-all duration-300 hover:border-red/30 hover:-translate-y-1.5 hover:shadow-[0_20px_50px_rgba(0,0,0,.4)]
                  reveal rd${i + 1}`}
                        >
                            <div class="font-mono text-[0.65rem] tracking-[0.2em] text-dim mb-5 relative z-10">
                                {num} ——
                            </div>
                            <div
                                class="w-12 h-12 rounded-xl flex items-center justify-center mb-5 text-[1.4rem] relative z-10"
                                style={iconWrapStyle[iconColor]}
                            >
                                {icon}
                            </div>
                            <h3 class="font-heading text-base font-bold text-fore mb-2.5 relative z-10">
                                {title}
                            </h3>
                            <p class="text-[0.825rem] text-dim leading-[1.7] flex-1 mb-5 relative z-10">
                                {desc}
                            </p>
                            <div class="flex flex-wrap gap-1.5 relative z-10">
                                {tags.map((tag) => (
                                    <span
                                        class="font-mono text-[0.6rem] px-2.5 py-1 rounded-[0.3rem] tracking-[0.05em]"
                                        style={tagStyle[tagColor]}
                                    >
                                        {tag}
                                    </span>
                                ))}
                            </div>
                        </div>
                    ),
                )
            }

            <!-- CTA card -->
            <div
                class={`reveal rd5 flex items-center justify-center text-center p-8 rounded-2xl min-h-[220px]
                border border-dashed`}
                style="border-color:rgba(255,255,255,.08);"
            >
                <div>
                    <div class="text-[2rem] mb-3 opacity-30">💡</div>
                    <p class="font-heading text-[0.9rem] text-dim mb-2">
                        ¿Tienes algo en mente?
                    </p>
                    <p class="font-mono text-[0.7rem] text-dim/50 mb-4">
                        Cuéntame tu idea
                    </p>
                    <a
                        href="#contact"
                        class="btn-primary text-[0.78rem] py-2 px-4"
                    >
                        <span>Hablemos →</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
