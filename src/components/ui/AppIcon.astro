---
type Props = {
    className?: string
} 

const { className } = Astro.props
---

<svg
    xmlns="http://www.w3.org/2000/svg"
    width="200"
    height="200"
    viewBox="0 0 200 200"
    class={className}
>
    <defs>
        <filter id="glow" width="220%" height="220%" x="-60%" y="-60%">
            <feGaussianBlur result="blur" stdDeviation="3"></feGaussianBlur>
            <feMerge>
                <feMergeNode in="blur"></feMergeNode>
                <feMergeNode in="blur"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
            </feMerge>
        </filter>
        <filter id="softGlow" width="300%" height="300%" x="-100%" y="-100%">
            <feGaussianBlur result="blur" stdDeviation="10"></feGaussianBlur>
            <feMerge>
                <feMergeNode in="blur"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
            </feMerge>
        </filter>
        <linearGradient id="mainGrad" x1="0%" x2="100%" y1="0%" y2="100%">
            <stop offset="0%" stop-color="#00d4ff"></stop>
            <stop offset="50%" stop-color="#8b5cf6"></stop>
            <stop offset="100%" stop-color="#ff2d55"></stop>
        </linearGradient>
    </defs>
    <path
        fill="none"
        stroke="url(#mainGrad)"
        stroke-width="11.3"
        d="m100 13.5 86.5 86.5-86.5 86.5L13.5 100z"
        filter="url(#softGlow)"
        opacity=".38"></path>
    <path
        fill="none"
        stroke="url(#mainGrad)"
        stroke-width="1.4"
        d="m100 13.5 86.5 86.5-86.5 86.5L13.5 100z"
        filter="url(#glow)"></path>
    <circle cx="100" cy="13.5" r="2.8" fill="#00d4ff" filter="url(#glow)"
    ></circle>
    <circle cx="186.5" cy="100" r="2.8" fill="#8b5cf6" filter="url(#glow)"
    ></circle>
    <circle cx="100" cy="186.5" r="2.8" fill="#ff2d55" filter="url(#glow)"
    ></circle>
    <circle cx="13.5" cy="100" r="2.8" fill="#00d4ff" filter="url(#glow)"
    ></circle>
    <path
        fill="none"
        stroke="url(#mainGrad)"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="4.7"
        d="M59.6 136.7V62.4L100 98.1l40.4-35.7v74.3"
        filter="url(#glow)"></path>
    <circle cx="59.6" cy="136.7" r="4.2" fill="#00d4ff" filter="url(#glow)"
    ></circle>
    <circle cx="59.6" cy="62.4" r="4.2" fill="#06b6d4" filter="url(#glow)"
    ></circle>
    <circle cx="100" cy="98.1" r="4.2" fill="#8b5cf6" filter="url(#glow)"
    ></circle>
    <circle cx="140.4" cy="62.4" r="4.2" fill="#c026d3" filter="url(#glow)"
    ></circle>
    <circle cx="140.4" cy="136.7" r="4.2" fill="#ff2d55" filter="url(#glow)"
    ></circle>
    <path
        stroke="#00d4ff"
        stroke-width="1.9"
        d="M50.2 136.7h9.4"
        filter="url(#glow)"></path>
    <path
        stroke="#ff2d55"
        stroke-width="1.9"
        d="M140.4 136.7h9.4"
        filter="url(#glow)"></path>
</svg>
