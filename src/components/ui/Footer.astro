---
const year = new Date().getFullYear();
const isAuthenticated = Boolean(Astro.locals.currentUser);
---

<footer class="border-t border-stroke py-10">
    <div class="max-w-[1152px] mx-auto px-6">
        <div class="flex items-center justify-between flex-wrap gap-4">
            <!-- Logo + name -->
            <div class="flex items-center gap-2">
                <div
                    class="w-6 h-6 rounded-[0.3rem] flex items-center justify-center font-display text-[0.75rem] font-bold text-red"
                    style="border:1px solid rgba(255,45,85,.5);"
                >
                    D
                </div>
                <span class="font-mono text-[0.8rem] text-dim"
                    >Diego Meneses Pérez</span
                >
            </div>

            <p class="font-mono text-[0.7rem] text-dim text-center">
                &copy; 2026 · Construido con <span class="text-red">♥</span> en
                <span class="text-neon">Astro.js</span>
            </p>

            {
                isAuthenticated ? (
                    <div class="flex items-center gap-4 text-xs font-mono">
                        <a
                            href="/projects"
                            class="text-neon hover:text-white transition-colors"
                        >
                            Proyectos
                        </a>
                        <a
                            href="/settings"
                            class="text-neon hover:text-white transition-colors"
                        >
                            Configuración
                        </a>
                    </div>
                ) : (
                    <div class="flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse-dot" />
                        <span class="font-mono text-[0.7rem] text-dim">
                            Listo para nuevos retos
                        </span>
                    </div>
                )
            }
        </div>
    </div>
</footer>
