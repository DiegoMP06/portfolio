---
import { Pencil, Eye, FolderGit2, Link2 } from "lucide-react";
import type { FormattedProject } from "../../types";
import CloudinaryImage from "../cloudinary/CloudinaryImage.astro";
import ProjectOptions from "./ProjectOptions";

type Props = {
    project: FormattedProject;
};

const { project } = Astro.props;

const featureImage = project.media.find((m) => m.featured)?.url || "";
---

<article class="card-glass p-5 flex flex-col gap-4">
    <div>
        <CloudinaryImage
            publicId={featureImage}
            alt={`Imagen de ${project.name}`}
            width={640}
            height={360}
        />
    </div>

    <div class="flex items-start justify-between gap-3">
        <a href={`/projects/${project.slug}`}>
            <h2
                class="text-lg font-heading text-white leading-tight hover:underline hover:text-cyan transition-colors cursor-pointer"
            >
                {project.name}
            </h2>
        </a>

        {
            project.featured && (
                <span class="text-xs font-mono text-purple border border-purple/40 bg-purple/10 px-2 py-0.5 rounded">
                    Destacado
                </span>
            )
        }
    </div>

    <p class="text-slate-300 text-sm line-clamp-3">
        {project.description}
    </p>

    <div class="flex flex-wrap gap-2">
        {
            (project.stack as string[]).map((tech) => (
                <span class="text-xs font-mono border border-stroke px-2 py-0.5 rounded text-slate-300">
                    {tech}
                </span>
            ))
        }
    </div>

    <div
        class="mt-auto flex items-center gap-3 pt-3 border-t border-stroke text-sm flex-wrap"
    >
        <a
            href={`/projects/${project.slug}`}
            class="text-neon hover:text-cyan transition-colors flex gap-1 items-center border border-neon px-2 py-1 rounded hover:border-cyan"
        >
            <Eye className="size-4" />
            Ver
        </a>

        <a
            href={`/projects/${project.id}/edit`}
            class="text-slate-200 hover:text-white transition-colors flex gap-1 items-center border border-slate-200 px-2 py-1 rounded hover:border-white"
        >
            <Pencil className="size-4" />
            Editar
        </a>

        <ProjectOptions
            projectId={project.id}
            featured={project.featured}
            client:load
        />

        <a
            href={project.githubUrl}
            target="_blank"
            rel="noreferrer"
            class="text-slate-400 hover:text-white transition-colors flex gap-1 items-center border border-slate-400 px-2 py-1 rounded hover:border-white"
        >
            <FolderGit2 className="size-4" />
            GitHub
        </a>

        {
            project.demoUrl && (
                <a
                    href={project.demoUrl}
                    target="_blank"
                    rel="noreferrer"
                    class="text-purple hover:text-purple transition-colors flex gap-1 items-center border border-purple px-2 py-1 rounded hover:border-purple"
                >
                    <Link2 className="size-4" />
                    Demo
                </a>
            )
        }
    </div>
</article>

